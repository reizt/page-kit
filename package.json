{
  "name": "page-kit",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.12",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "wrangler deploy --dry-run",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "lint": "biome lint .",
