    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@cloudflare/playwright": "^1.3.6",
    "@mozilla/readability": "^0.6.0",
    "agents": "^0.28.1",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "linkedom": "^0.18.13",
    "marked": "^18.1.1",
    "turndown": "^7.2.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@cloudflare/vitest-plugin": "^1.0.0",
    "@cloudflare/workers-types": "^5.20261016.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@types/node": "^26.6.5",
    "@types/turndown": "^5.0.6",
    "lefthook": "^2.2.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.1"
  },
  "engines": {
    "node": ">=22"
  }
